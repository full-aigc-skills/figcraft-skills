{
  "schema": "craft-scenario-playbooks/v1",
  "application": "figcraft",
  "id": "import-fig",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "导入实际Figma文件",
      "command": "file.open",
      "params": {
        "path": "input/design.fig"
      }
    },
    {
      "purpose": "查看导入后的组件结构",
      "command": "component.list",
      "params": {}
    },
    {
      "purpose": "导出可核对的SVG",
      "command": "file.exportSvg",
      "params": {
        "path": "output/import-proof.svg"
      }
    }
  ],
  "check": "逐画框检查文字、组件、蒙版、颜色和导入warnings。",
  "boundary": "fig是best effort，不把可打开当完整保真；变量文件需按当前file.open说明另传。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
