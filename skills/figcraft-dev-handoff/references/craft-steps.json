{
  "schema": "craft-scenario-playbooks/v1",
  "application": "figcraft",
  "id": "dev-handoff",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "列出可复用组件",
      "command": "component.list",
      "params": {}
    },
    {
      "purpose": "检查选中组件的实际属性",
      "command": "component.properties",
      "params": {}
    },
    {
      "purpose": "导出已有导出设置的资源",
      "command": "file.exportLayers",
      "params": {
        "dir": "output/assets",
        "assets": true
      }
    }
  ],
  "check": "核对尺寸、间距、字重、颜色、组件变体与资源命名；实际重开资源。",
  "boundary": "资源导出只覆盖有设置的节点；不能把截图当可实现的完整交互规格。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
