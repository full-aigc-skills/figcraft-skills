{
  "schema": "craft-scenario-playbooks/v1",
  "application": "figcraft",
  "id": "design-system",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立按钮组件底稿",
      "command": "node.create",
      "params": {
        "type": "frame",
        "name": "Button/Primary",
        "width": 160,
        "height": 48
      }
    },
    {
      "purpose": "选中底稿后转为组件",
      "command": "component.create",
      "params": {}
    },
    {
      "purpose": "列出真实组件供实例化",
      "command": "component.list",
      "params": {}
    },
    {
      "purpose": "检查组件属性",
      "command": "component.properties",
      "params": {}
    }
  ],
  "check": "组件可编辑、命名一致、实例复用，文本和状态变化不破坏布局。",
  "boundary": "创建和选择是不同动作；component.create前应使用实际选中或ids返回值。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
