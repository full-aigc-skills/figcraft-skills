{
  "schema": "craft-scenario-playbooks/v1",
  "application": "figcraft",
  "id": "responsive-layout",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "创建响应布局容器",
      "command": "node.create",
      "params": {
        "type": "frame",
        "name": "Cards",
        "width": 768,
        "height": 1024
      }
    },
    {
      "purpose": "对明确选中的容器启用自动布局",
      "command": "layout.add",
      "params": {
        "direction": "vertical"
      }
    },
    {
      "purpose": "建立文本与按钮子项后测试对齐",
      "command": "align.hcenter",
      "params": {}
    }
  ],
  "check": "在390×884、768×1024、1280×1024检查溢出、换行与按钮可达。",
  "boundary": "尺寸变化不自动等于响应式；先绑定父子、fill/hug和约束，使用node.set真实字段。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
